            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "primitive"
              },
              "kind": {
                "enum": [
                  "cube",
                  "plane",
                  "cylinder",
                  "cone",
                  "sphere",
                  "icosphere"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "segments": {
                "type": "integer",
                "minimum": 3,
                "maximum": 64
              },
              "latitudeSegments": {
                "type": "integer",
                "minimum": 2,
                "maximum": 64
              },
              "subdivisions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "roughness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "metalness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "shading": {
                "enum": [
                  "flat",
                  "smooth"
                ]
              }
            },
            "required": [
              "op",
              "kind",
              "name"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "tube"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "segments": {
                "type": "integer",
                "minimum": 3,
                "maximum": 64
              },
              "capped": {
                "type": "boolean"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "roughness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "metalness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "shading": {
                "enum": [
                  "flat",
                  "smooth"
                ]
              }
            },
            "required": [
              "op",
              "name",
              "path",
              "radius"
            ]
