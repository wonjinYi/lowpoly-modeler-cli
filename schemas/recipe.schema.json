                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "segments": {
                "const": 1
              }
            },
            "required": [
              "op",
              "target",
              "width"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "extrude"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "faces": {
                "anyOf": [
                  {
                    "enum": [
                      "all",
                      "top",
                      "bottom",
                      "front",
                      "back",
                      "left",
                      "right"
                    ]
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "distance": {
                "type": "number"
              },
              "rotate": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "op",
              "target",
              "faces",
              "distance"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "inset"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "faces": {
                "anyOf": [
                  {
                    "enum": [
                      "all",
                      "top",
                      "bottom",
                      "front",
                      "back",
                      "left",
                      "right"
                    ]
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "factor": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            },
            "required": [
              "op",
              "target",
              "faces",
              "factor"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "delete_faces"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "faces": {
                "anyOf": [
                  {
                    "enum": [
                      "all",
                      "top",
                      "bottom",
                      "front",
                      "back",
                      "left",
                      "right"
                    ]
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            },
            "required": [
              "op",
              "target",
