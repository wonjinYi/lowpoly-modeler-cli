          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "group"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "op",
