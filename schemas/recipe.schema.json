            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "subdivide"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "edges": {
                "anyOf": [
                  {
                    "const": "all"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            },
            "required": [
              "op",
              "target"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "transform_vertices"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "vertices": {
                "anyOf": [
                  {
                    "const": "all"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "translate": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "rotate": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
