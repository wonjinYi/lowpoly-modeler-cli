              },
              "angle": {
                "type": "number"
              },
              "origin": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "op",
              "target",
              "axis",
              "angle"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "bevel"
