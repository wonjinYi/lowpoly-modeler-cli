            },
            "required": [
              "op",
              "target",
              "axis"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "bend"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "axis": {
                "enum": [
                  "x",
                  "y",
                  "z"
