{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lowpoly.local/recipe.schema.json",
  "title": "Lowpoly Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "steps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forward": {
          "const": "+Z"
        },
        "groundY": {
          "type": "number"
        },
        "groundTolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
